# Copiar a .env y completar. No subir .env al repositorio.

# development | production (production activa cookies Secure y HSTS; requiere HTTPS)
RADAR_ENV=development

# Obligatoria, mínimo 32 caracteres. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RADAR_SECRET_KEY=

# Directorio de datos (base, bloqueo del recolector, backups). Por defecto ./data
# En producción: /var/lib/radar (fuera de directorios públicos).
# RADAR_DATA_DIR=/var/lib/radar
# Ruta de la base SQLite (por defecto RADAR_DATA_DIR/radar.db)
# RADAR_DATABASE_URL=sqlite:////var/lib/radar/radar.db
# Backups (por defecto RADAR_DATA_DIR/backups) y cuántos conservar
# RADAR_BACKUP_DIR=/var/lib/radar/backups
# RADAR_BACKUP_KEEP=14
# Retención en días (0 = no borrar): notas y ejecuciones/uso/avisos
# RADAR_RETENTION_DAYS=365
# RADAR_RUNS_RETENTION_DAYS=30
# Panel: dirección y puerto locales (Nginx hace de proxy)
# RADAR_HOST=127.0.0.1
# RADAR_PORT=8000

# Datos ficticios identificados como DEMO (solo para pruebas locales)
RADAR_DEMO_MODE=false

# Identificación del recolector ante los medios (incluir un contacto real)
# RADAR_USER_AGENT=RadarTitulares/0.1 (+https://tu-dominio; contacto@tu-dominio)
# RADAR_HTTP_TIMEOUT=20
# Separación mínima (s) entre solicitudes al mismo dominio. El Destape usa 10 (Crawl-delay).
# RADAR_REQUEST_DELAY=2
# Descargas simultáneas (máximo recomendado en el VPS: 2)
# RADAR_MAX_CONCURRENCY=2
# Reintentos ante timeout/5xx/429 (con backoff exponencial)
# RADAR_HTTP_RETRIES=2
# Tamaño máximo de cada respuesta (bytes)
# RADAR_MAX_RESPONSE_BYTES=10485760
# Páginas de notas leídas por medio y por ejecución (0 = no leer páginas)
# RADAR_ENRICH_PER_MEDIA=10

# Sesión y login
# RADAR_SESSION_MAX_AGE=43200
# RADAR_LOGIN_MAX_FAILURES=5
# RADAR_LOGIN_WINDOW_SECONDS=900

# Telegram (opcional, DESACTIVADO por defecto). Avisos breves con enlace al panel.
# RADAR_TELEGRAM_ENABLED=false
# RADAR_TELEGRAM_BOT_TOKEN=
# RADAR_TELEGRAM_CHAT_ID=
# URL del panel usada en los enlaces de los avisos
# RADAR_PUBLIC_URL=https://radar.tu-dominio

# Análisis con IA externa (opcional, DESACTIVADO por defecto). Ver README.
# RADAR_AI_ENABLED=false
# Proveedores en orden; si uno falla o se queda sin cuota se usa el siguiente.
# Opciones: groq, fireworks, anthropic.
# RADAR_AI_PROVIDER=groq,fireworks
#
# Groq (https://console.groq.com). El modelo es obligatorio: elegilo del catálogo de Groq.
# Con RADAR_GROQ_STRICT=true se pide esquema estricto; solo algunos modelos lo admiten.
# GROQ_API_KEY=
# RADAR_GROQ_MODEL=
# RADAR_GROQ_STRICT=true
#
# Fireworks (https://fireworks.ai). Modelo obligatorio, formato accounts/fireworks/models/...
# FIREWORKS_API_KEY=
# RADAR_FIREWORKS_MODEL=
#
# Anthropic (opcional). Credencial: la que resuelve el SDK (ANTHROPIC_API_KEY o `ant auth login`).
# ANTHROPIC_API_KEY=
# RADAR_AI_MODEL=claude-opus-5-5
# RADAR_AI_EFFORT=medium
# Reintento automático en otro modelo de Anthropic si el elegido declina la solicitud
# RADAR_AI_FALLBACKS=true
# RADAR_AI_TIMEOUT=120
# RADAR_AI_MAX_RETRIES=2
# RADAR_AI_MAX_INPUT_CHARS=12000
# RADAR_AI_MAX_OUTPUT_TOKENS=8192
# RADAR_AI_MAX_PER_RUN=10
# RADAR_AI_DAILY_MAX_REQUESTS=50
# RADAR_AI_DAILY_MAX_TOKENS=300000
# Tarifas propias (USD por millón de tokens). Sin ellas no se estima costo ni se aplica presupuesto.
# RADAR_AI_PRICE_INPUT_PER_MTOK=
# RADAR_AI_PRICE_OUTPUT_PER_MTOK=
# RADAR_AI_DAILY_BUDGET_USD=
# RADAR_AI_BREAKER_FAILURES=3
# RADAR_AI_BREAKER_MINUTES=30

# --- Vista pública (visitantes sin login, solo lectura) ---
# true permite ver Resumen, Noticias, Grupos, Cronología, Métricas y Fuentes sin ingresar
RADAR_PUBLIC_MODE=false
# Alertas visibles para visitantes: revisadas | ninguna | todas
RADAR_PUBLIC_ALERTS=revisadas
# Solicitudes por minuto e IP para visitantes (0 = sin límite)
RADAR_PUBLIC_RATE_LIMIT=120

# --- PostgreSQL / Neon (opcional; sin esto se usa SQLite en RADAR_DATA_DIR) ---
# Cadena CON pooler (host con -pooler) para la aplicación. Se acepta postgres:// o postgresql://.
# RADAR_DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/BASE?sslmode=require&channel_binding=require
# Cadena DIRECTA (sin -pooler) para migraciones y backups. Si falta, se deriva quitando "-pooler".
# RADAR_DATABASE_URL_DIRECT=postgresql://USUARIO:CLAVE@ep-xxxx.REGION.aws.neon.tech/BASE?sslmode=require&channel_binding=require

# --- Vercel ---
# Protege /api/cron (Vercel lo envía como "Authorization: Bearer ..."). Sin esto el cron responde 503.
# CRON_SECRET=
# Solo para demostraciones: permite SQLite efímera en Vercel (se pierde al apagarse la instancia).
# RADAR_ALLOW_EPHEMERAL_DB=false
