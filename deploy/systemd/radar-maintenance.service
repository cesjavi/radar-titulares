# Radar de Titulares - mantenimiento diario: backup consistente (API de SQLite, verificado,
# con rotación) y luego retención del histórico. Si el backup falla, no se purga nada.
[Unit]
Description=Radar de Titulares (backup y retención)
After=network.target

[Service]
Type=oneshot
User=radar
Group=radar
WorkingDirectory=/opt/radar/current
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/radar/radar.env
ExecStart=/opt/radar/current/.venv/bin/python -m radar backup
ExecStart=/opt/radar/current/.venv/bin/python -m radar purge
TimeoutStartSec=30min
Nice=15
IOSchedulingClass=idle
MemoryMax=300M
LogNamespace=radar

UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/radar
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
